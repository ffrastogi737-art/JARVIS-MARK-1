# Copy to .env and fill in. All providers below have free tiers — no paid keys.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# OpenRouter (backup, ":free" models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

CLASSIFIER_MODEL=groq/llama-3.1-8b-instant
TIER_SIMPLE_MODEL=groq/llama-3.1-8b-instant
TIER_MODERATE_MODEL=groq/llama-3.3-70b-versatile
TIER_COMPLEX_MODEL=google/gemini-2.5-flash
TIER_EXPERT_MODEL=google/gemini-2.5-pro
FALLBACK_MODELS=groq/llama-3.3-70b-versatile,google/gemini-2.5-flash,openrouter/meta-llama/llama-3.3-70b-instruct:free,groq/llama-3.1-8b-instant
